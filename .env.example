APP_NAME="AGILE"
# On a server use APP_ENV=production and APP_DEBUG=false. See the production checklist in docs/security-review.md.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
# true adds 100 more made-up people (ExeComm to applicants) when database/setup.php seeds. Ignored in production.
DEMO_BULK=false
APP_KEY=
ORG_CONTACT_EMAIL=contact@agile.test
# Shown in the public footer. Leave empty to hide.
ORG_MSW_EMAIL=
ORG_FACEBOOK_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agile_ams
DB_USER=root
DB_PASS=

ENCRYPTION_KEY=

# Backups. Leave empty to find mysqldump automatically and use storage/backups.
MYSQLDUMP_PATH=
BACKUP_DIR=

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@agile.test
MAIL_FROM_NAME="AGILE"
MAIL_LOGO_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls

SESSION_IDLE_MINUTES=30

# Optional eligibility suggestions (BR-11). none or anthropic. Turning it on sends documents to the provider.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-5-5
