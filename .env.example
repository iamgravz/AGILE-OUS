APP_ENV=local
APP_URL=http://localhost:8000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agile_ous
DB_USER=agile_app
DB_PASSWORD=CHANGE_ME
SESSION_SECURE=false

# PRIVILEGED MFA IS MANDATORY in this branch. Use a unique 32-byte random
# secret encoded as base64, provided through a protected host secret manager.
# Generate locally: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# Never commit or share your real key. If missing, enrollment fails closed.
MFA_KEY_B64=

# All integrations and consequential actions are OFF by default.
# Never commit .env or genuine secrets to GitHub.
# Phase 9 private-document security. Uploaded files remain quarantined until
# a trusted CLI ClamAV scan clears them; all prior stored files must be scanned.
FILE_SCANNING_ENABLED=false
FILE_SCAN_DRIVER=clamav
SECURITY_MONITOR_ENABLED=false
# Pair an authenticated MySQL backup with a separate encrypted private-file backup.
# Keep both keys in a protected secret manager, never GitHub.
AGILE_BACKUP_KEY_B64=
AGILE_FILE_BACKUP_KEY_B64=
# AGILE_FILE_BACKUP_DIR=/srv/agile/backups/private
# AGILE_PRIVATE_FILES_DIR=/srv/agile/app/storage/private
AGILE_ALLOW_ISOLATED_RESTORE=false

MAIL_TRANSPORT=disabled
AUTOMATION_ENABLED=false
ACADEMIC_ROLE_TRANSITIONS_ENABLED=false
AI_EXTERNAL_PROCESSING_APPROVED=false
AI_EXTRACT_PROVIDER=disabled
AI_EXTRACT_MODEL=
# GMAIL_SENDER=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# OPENAI_API_KEY=
