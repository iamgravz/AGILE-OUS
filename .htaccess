# Only public/ belongs on the web. If this folder ever sits under a server's document root (for example
# C:\xampp\htdocs\agile), this stops .env, storage/, backups, uploads and the source code from being served.
# public/.htaccess opens that one folder again.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
