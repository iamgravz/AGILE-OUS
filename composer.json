{
    "name": "agile/membership-welfare-system",
    "description": "AGILE Web-Based Membership and Student Welfare Management System",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "anthropic-ai/sdk": "^1.3",
        "dompdf/dompdf": "^3.1",
        "endroid/qr-code": "^6.0",
        "ezyang/htmlpurifier": "^4.19",
        "nyholm/psr7": "^1.8",
        "phpmailer/phpmailer": "^7.1",
        "symfony/http-client": "^7.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/phpunit/phpunit/phpunit"
        ]
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
