# Example TLS-only staging virtual host. Replace ALL __PLACEHOLDERS__
# using an approved deployment process. No real student data in staging.
server {
    listen 80;
    server_name __STAGING_HOST__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name __STAGING_HOST__;
    root __APP_ROOT__/public;
    index index.php;
    charset utf-8;

    ssl_certificate __TLS_CERT__;
    ssl_certificate_key __TLS_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 6m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control "no-store" always;

    # Never expose source code, environment secrets, runtime documents,
    # staging backups, VCS paths or temporary archives.
    location ~ /\. { deny all; }
    location ~* \.(?:sql|sql\.gz|env|ini|log|bak|afb|abk|key|pem|dump)$ { deny all; }

    location / {
        try_files $uri /index.php?$query_string;
    }

    location ~ \.php$ {
        # Only the public front-controller is executable.
        if ($uri != /index.php) { return 404; }
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param HTTPS on;
        fastcgi_pass __PHP_FPM_UPSTREAM__;
        fastcgi_read_timeout 60s;
    }

    location ~* ^/(?:storage|vendor|tests|scripts|database|jobs)/ { deny all; }
}
