Options -Indexes

# The project root's .htaccess shuts everything else. This is the one folder that belongs on the web.
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
</IfModule>

# Compression: text files are sent gzipped. Lighthouse mobile on the home page goes from about 87 to 96 with it.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Assets may be cached for a week. asset() adds ?v=<file time>, so a changed CSS or JS file is fetched at once.
# Pages themselves are not cached: they are personal, and Session sets no-cache on them.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|jpe?g|webp|gif|ico|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Existing files such as assets are served directly; everything else goes to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
